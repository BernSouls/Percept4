@@ -1558,6 +1702,15 @@ def evidence_score(
         trace["edge_absence"] = edge_absence
         trace["total_absence"] = absence
         trace["core_coverage"] = core_coverage
+        # [D3] `node_coverage` above is the node term the score USED. The two
