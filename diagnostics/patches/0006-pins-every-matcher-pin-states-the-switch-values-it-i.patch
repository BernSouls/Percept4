Date: Tue, 10 Nov 2026 22:55:41 +0000
Subject: pins: every matcher pin states the switch values it is written
 against

conftest.PIN_BASELINE (PERCEPT_PIN_BASELINE=0 disables it for triage); test_declared_defaults.py is the one test that reddens on a default flip.

Co-authored-by: arena-agent <297053741+arena-agent@users.noreply.github.com>
---
 tests_matcher/conftest.py               | 50 +++++++++++++++++++++++++
 tests_matcher/test_declared_defaults.py | 25 +++++++++++++
 2 files changed, 75 insertions(+)
 create mode 100644 tests_matcher/test_declared_defaults.py

diff --git a/tests_matcher/conftest.py b/tests_matcher/conftest.py
index c270593..2a91ae6 100644
--- a/tests_matcher/conftest.py
+++ b/tests_matcher/conftest.py
@@ -26,6 +26,56 @@ if os.path.isdir(SHIMS) and SHIMS not in sys.path:
     sys.path.append(SHIMS)
 
 
+#: The switch values every pin in this directory is written against.  A pin
+#: that tests another value sets it through ``params``.  Stating them here
+#: keeps the pins independent of the tree's defaults: flipping a default
+#: reddens exactly one test (``test_declared_defaults.py``), not every pin
+#: that happened to rely on it.
+PIN_BASELINE = {
+    "EDGE_UNPARAMETERISED_STRUCTURAL_MATCH": True,     # F6
+    "EVIDENCE_GRADED_NODE_CREDIT": True,               # D1
+    "EVIDENCE_QUERY_SIDE_TERMS": (),                   # D3
+    "EDGE_UNMEASURED_IS_NOT_EVIDENCE": True,           # Phase 4
+    "EVIDENCE_NODE_NULL_CALIBRATED": False,            # null calibration
+}
+
+#: the tree's own values, read once before any pin touches them
+_DECLARED = {}
+
+
+@pytest.fixture(autouse=True)
+def _pin_baseline(monkeypatch):
+    """Put every gap-closure switch at the value the pins are written for.
+
+    TRIAGE: with ``PERCEPT_PIN_BASELINE=0`` in the environment the baseline
+    is NOT applied, so the pins run under whatever the tree (or
+    ``diagnostics/_param_overrides_plugin.py``) has set.  A pin that fails
+    then is one whose expectation depends on a switch it does not set itself
+    -- the instrument used to classify the pins in REPORT.md
+    (``diagnostics/phase2_pin_triage.py``).
+
+    WITH the baseline applied, a ``PERCEPT_PARAMS`` override does not reach
+    these pins (the baseline is set after it), so "the matcher pins are green
+    under override X" says nothing.  What a pin reads under the OTHER values
+    is pinned explicitly in ``test_switch_interactions.py``, which sets every
+    switch itself.
+    """
+    import parameters as P
+
+    apply = os.environ.get("PERCEPT_PIN_BASELINE", "1") != "0"
+    for k, v in PIN_BASELINE.items():
+        assert hasattr(P, k), "unknown parameter %r" % k
+        _DECLARED.setdefault(k, getattr(P, k))
+        if apply:
+            monkeypatch.setattr(P, k, v)
+
+
+@pytest.fixture
+def declared_defaults(_pin_baseline):
+    """The switch values the tree declares (before the pin baseline)."""
+    return dict(_DECLARED)
+
+
 @pytest.fixture
 def params(monkeypatch):
     """Set ``parameters.NAME`` for one test; restored afterwards."""
diff --git a/tests_matcher/test_declared_defaults.py b/tests_matcher/test_declared_defaults.py
new file mode 100644
index 0000000..097478b
--- /dev/null
+++ b/tests_matcher/test_declared_defaults.py
@@ -0,0 +1,25 @@
+"""PIN -- the defaults the tree declares for the gap-closure switches.
+
+Every other pin in this directory states the switch values it is written
+against (``conftest.PIN_BASELINE``), so it does not move when a default
+does.  THIS is the one test that reddens when a default is flipped: change
+the expected value here in the same commit, on purpose.
+
+Why each default is what it is: ``diagnostics/REPORT.md``.
+"""
+from __future__ import annotations
+
+
+def test_declared_defaults(declared_defaults):
+    assert declared_defaults == {
+        # F6 -- landed on; a parameter-less pair matches as structure
+        "EDGE_UNPARAMETERISED_STRUCTURAL_MATCH": True,
+        # D1 -- landed on; its success signal was NOT met
+        "EVIDENCE_GRADED_NODE_CREDIT": True,
+        # D3 -- in the tree, OFF: its pre-registered rule failed
+        "EVIDENCE_QUERY_SIDE_TERMS": (),
+        # Phase 4 -- on by the spec; never exercised on ETH-80
+        "EDGE_UNMEASURED_IS_NOT_EVIDENCE": True,
+        # null calibration -- in the tree, OFF: its rule failed
+        "EVIDENCE_NODE_NULL_CALIBRATED": False,
+    }
