+        edges.add((min(a, b), max(a, b), rng.choice(ET)))
+    sg = Subgraph(nodes=frozenset(ids), edges=frozenset(edges))
+    sg.anchor_of_node = {nid: (rng.uniform(0, 100), rng.uniform(0, 100))
+                         for nid in ids if rng.random() < 0.9}
+    return sg, sigs
